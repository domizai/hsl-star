// END TABLES

// The table steps evenly through the HSL* hue and gives the HSV hue,
// unwrapped, so neighbouring entries can be interpolated. Both directions
// read the same table, so they undo each other exactly: forwards by index,
// backwards by a binary search.
float hslStarToHsvHue(float h) {
  float x = mod(h, 360.0) * (float(HSL_STAR_TABLE_STEPS) / 360.0);
  int i = min(int(x), HSL_STAR_TABLE_STEPS - 1);
  return mod(mix(HSL_STAR_TO_HSV_HUE[i], HSL_STAR_TO_HSV_HUE[i + 1], x - float(i)), 360.0);
}

float hslStarFromHsvHue(float hsv) {
  hsv = mod(hsv, 360.0);
  int lo = 0;
  int hi = HSL_STAR_TABLE_STEPS;
  while (hi - lo > 1) {
    int mid = (lo + hi) / 2;
    if (HSL_STAR_TO_HSV_HUE[mid] <= hsv) lo = mid;
    else hi = mid;
  }
  float t = (hsv - HSL_STAR_TO_HSV_HUE[lo]) / (HSL_STAR_TO_HSV_HUE[hi] - HSL_STAR_TO_HSV_HUE[lo]);
  return mod((float(lo) + t) * (360.0 / float(HSL_STAR_TABLE_STEPS)), 360.0);
}

// --- Saturation correction ------------------------------------------------------

// As in hsl-star.js: hues whose most vivid color is more colorful, in OKLab
// chroma, than the median hue's at that lightness get a strength r > 1,
// faded in over the first quarter above the median, and saturation becomes
// the share t = s / (r + (1 - r) s) of the vivid color. Both directions use
// the same r, so they undo each other exactly.
const float HSL_STAR_STRENGTH = 0.6;
const float HSL_STAR_FADE = 0.25;

// OKLab chroma of a linear sRGB color (Ottosson 2020).
float hslStarOklabChroma(vec3 rgb) {
  vec3 lms = vec3(
    dot(rgb, vec3(0.4122214708, 0.5363325363, 0.0514459929)),
    dot(rgb, vec3(0.2119034982, 0.6806995451, 0.1073969566)),
    dot(rgb, vec3(0.0883024619, 0.2817188376, 0.6299787005)));
  lms = pow(max(lms, 0.0), vec3(1.0 / 3.0));
  vec2 ab = vec2(
    dot(lms, vec3(1.9779984951, -2.428592205, 0.4505937099)),
    dot(lms, vec3(0.0259040371, 0.7827717662, -0.808675766)));
  return length(ab);
}

// The median hue's OKLab chroma at s = 1 and lightness l, between the
// table's steps of half an L*.
float hslStarReferenceChroma(float l) {
  float x = clamp(l, 0.0, 100.0) * (float(HSL_STAR_CHROMA_STEPS) / 100.0);
  int i = min(int(x), HSL_STAR_CHROMA_STEPS - 1);
  return mix(HSL_STAR_REFERENCE_CHROMA[i], HSL_STAR_REFERENCE_CHROMA[i + 1], x - float(i));
}

// The strength r for the vivid color a * pure + b at lightness l.
float hslStarStrength(vec3 pure, float a, float b, float l) {
  float c = hslStarOklabChroma(a * pure + b);
  float c0 = hslStarReferenceChroma(l);
  if (!(c > c0) || c <= 1e-6) return 1.0;
  float q = c / c0;
  float x = min(1.0, (q - 1.0) / HSL_STAR_FADE);
  return 1.0 + HSL_STAR_STRENGTH * x * x * (3.0 - 2.0 * x) * (q * sqrt(q) - 1.0);
}

// --- Hue shift --------------------------------------------------------------------

// As in hsl-star.js: on the OKLab axis, tints and lower saturations keep
// their pure color's OKLab hue, as the HSV hue x0 is shifted to x before the
// pure color is built. Tabulated at anchor hues every 2.5° of HSV hue, over a
// white share counted from the lightest pure color among an anchor and its
// neighbours (so pure colors don't move) and over s; bilinear between those,
// linear between anchors, and exactly undone backwards.

// Where v falls among the white shares or the saturations, as a fractional
// index.
float hslStarLocateW(float v) {
  if (v <= HSL_STAR_SHIFT_WS[0]) return 0.0;
  for (int i = 0; i < HSL_STAR_SHIFT_NW - 1; i++) {
    if (v <= HSL_STAR_SHIFT_WS[i + 1]) return float(i) + (v - HSL_STAR_SHIFT_WS[i]) / (HSL_STAR_SHIFT_WS[i + 1] - HSL_STAR_SHIFT_WS[i]);
  }
  return float(HSL_STAR_SHIFT_NW - 1);
}

float hslStarLocateS(float v) {
  if (v <= HSL_STAR_SHIFT_SS[0]) return 0.0;
  for (int i = 0; i < HSL_STAR_SHIFT_NS - 1; i++) {
    if (v <= HSL_STAR_SHIFT_SS[i + 1]) return float(i) + (v - HSL_STAR_SHIFT_SS[i]) / (HSL_STAR_SHIFT_SS[i + 1] - HSL_STAR_SHIFT_SS[i]);
  }
  return float(HSL_STAR_SHIFT_NS - 1);
}

// The shifted position of anchor k (any k, unwrapped) at luminance y, its s
// cell located as sx.
float hslStarAnchorAt(int k, float y, float sx) {
  int kk = k - HSL_STAR_SHIFT_ANCHORS * int(floor(float(k) / float(HSL_STAR_SHIFT_ANCHORS)));
  float yp = HSL_STAR_SHIFT_YREF[kk];
  float wx = hslStarLocateW(y <= yp ? 0.0 : (y - yp) / (1.0 - yp));
  int wi = min(int(wx), HSL_STAR_SHIFT_NW - 2);
  int si = min(int(sx), HSL_STAR_SHIFT_NS - 2);
  int at = (kk * HSL_STAR_SHIFT_NW + wi) * HSL_STAR_SHIFT_NS + si;
  float lo = mix(HSL_STAR_HUE_SHIFT[at], HSL_STAR_HUE_SHIFT[at + 1], sx - float(si));
  float hi = mix(HSL_STAR_HUE_SHIFT[at + HSL_STAR_SHIFT_NS], HSL_STAR_HUE_SHIFT[at + HSL_STAR_SHIFT_NS + 1], sx - float(si));
  return float(k) * HSL_STAR_SHIFT_STEP + mix(lo, hi, wx - float(wi));
}

// HSV hue x0 to the shifted x, at luminance y and saturation s.
float hslStarShiftHue(float x0, float y, float s) {
  float sx = hslStarLocateS(s);
  int k = min(HSL_STAR_SHIFT_ANCHORS - 1, int(x0 / HSL_STAR_SHIFT_STEP));
  float g0 = hslStarAnchorAt(k, y, sx);
  float g1 = hslStarAnchorAt(k + 1, y, sx);
  return mod(g0 + (x0 / HSL_STAR_SHIFT_STEP - float(k)) * (g1 - g0), 360.0);
}

// The shifted x back to x0: from x's own segment, a few steps to the one
// whose shifted ends hold it, then one linear step.
float hslStarUnshiftHue(float x, float y, float s) {
  float sx = hslStarLocateS(s);
  int k = int(floor(x / HSL_STAR_SHIFT_STEP));
  float g0 = hslStarAnchorAt(k, y, sx);
  float g1 = hslStarAnchorAt(k + 1, y, sx);
  for (int n = 0; n < HSL_STAR_SHIFT_ANCHORS && x < g0; n++) {
    k--;
    g1 = g0;
    g0 = hslStarAnchorAt(k, y, sx);
  }
  for (int n = 0; n < HSL_STAR_SHIFT_ANCHORS && x >= g1; n++) {
    k++;
    g0 = g1;
    g1 = hslStarAnchorAt(k + 1, y, sx);
  }
  return mod((float(k) + (x - g0) / (g1 - g0)) * HSL_STAR_SHIFT_STEP, 360.0);
}

// --- Forward and inverse ------------------------------------------------------

// Linear-light sRGB, channels in [0, 1].
vec3 hslStarToLinear(vec3 hls, int hueAxis) {
  float l = clamp(hls.y, 0.0, 100.0);
  float y = hslStarYFromLstar(l);
  float s = clamp(hls.z, 0.0, 1.0);
  // On the OKLab axis, the HSV hue shifted for this lightness and saturation.
  float hsv = hueAxis == HSL_STAR_HSV ? mod(hls.x, 360.0) : hslStarToHsvHue(hls.x);
  if (hueAxis != HSL_STAR_HSV && s > 0.0) hsv = hslStarShiftHue(hsv, y, s);
  vec3 pure = hslStarDecode(hslStarPureHue(hsv));
  float yPure = dot(pure, HSL_STAR_WEIGHTS);
  // Vivid color = a * pure + b (shade if b = 0, tint otherwise).
  float a = y <= yPure ? y / yPure : (1.0 - y) / (1.0 - yPure);
  float b = y <= yPure ? 0.0 : 1.0 - a;
  // Its share in the mix with grey: s itself at 0 and 1, else corrected.
  float t = s;
  if (s > 0.0 && s < 1.0) {
    float r = hslStarStrength(pure, a, b, l);
    t = s / (r + (1.0 - r) * s);
  }
  return clamp(t * a * pure + (t * b + (1.0 - t) * y), 0.0, 1.0);
}

vec3 hslStarFromLinear(vec3 rgb, int hueAxis) {
  float y = dot(rgb, HSL_STAR_WEIGHTS);
  float l = clamp(hslStarLstarFromY(y), 0.0, 100.0);
  float top = max(rgb.r, max(rgb.g, rgb.b));
  float bottom = min(rgb.r, min(rgb.g, rgb.b));
  float range = top - bottom;
  if (range < 1e-6) return vec3(0.0, l, 0.0);

  // Mixing with grey and scaling keep the normalised linear channels equal
  // to the pure color's, so normalising recovers it exactly.
  float hsv = hslStarHsvHueOf(hslStarEncode((rgb - bottom) / range));
  vec3 pure = hslStarDecode(hslStarPureHue(hsv));
  float yPure = dot(pure, HSL_STAR_WEIGHTS);
  // The vivid color's range, a in the forward direction, and its share t.
  float a = y <= yPure ? y / yPure : (1.0 - y) / (1.0 - yPure);
  float t = a > 0.0 ? clamp(range / a, 0.0, 1.0) : 0.0;
  // Undo the saturation correction with the forward direction's strength:
  // s = r t / (1 - (1 - r) t).
  float s = t;
  if (t > 0.0 && t < 1.0) {
    float r = hslStarStrength(pure, a, y <= yPure ? 0.0 : 1.0 - a, l);
    s = r * t / (1.0 - (1.0 - r) * t);
  }
  // On the OKLab axis, undo the hue shift: hsv is the shifted hue.
  return vec3(hueAxis == HSL_STAR_HSV ? hsv : hslStarFromHsvHue(hslStarUnshiftHue(hsv, y, s)), l, s);
}

// Gamma-encoded sRGB, channels in [0, 1].
vec3 hslStarToSrgb(vec3 hls, int hueAxis) {
  return hslStarEncode(hslStarToLinear(hls, hueAxis));
}

vec3 hslStarFromSrgb(vec3 rgb, int hueAxis) {
  return hslStarFromLinear(hslStarDecode(rgb), hueAxis);
}

// The same on the default OKLab hue axis.
vec3 hslStarToLinear(vec3 hls) { return hslStarToLinear(hls, HSL_STAR_OKLAB); }
vec3 hslStarFromLinear(vec3 rgb) { return hslStarFromLinear(rgb, HSL_STAR_OKLAB); }
vec3 hslStarToSrgb(vec3 hls) { return hslStarToSrgb(hls, HSL_STAR_OKLAB); }
vec3 hslStarFromSrgb(vec3 rgb) { return hslStarFromSrgb(rgb, HSL_STAR_OKLAB); }
